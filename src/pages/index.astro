---
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { credentials, talks, catalog } from '../data/profile';
import { getStars, getMediumPosts, getVideos, fmtDate } from '../lib/feeds';

const [stars, posts, videos] = await Promise.all([getStars(), getMediumPosts(3), getVideos(3)]);

const recentTalks = [...talks].sort((a, b) => b.year - a.year).slice(0, 3);
const featured = catalog.flatMap((t) => t.repos.filter((r) => r.featured).map((r) => ({ ...r, topic: t.topic })));
const repoUrl = (r: { name: string; owner?: string }) => `https://github.com/${r.owner ?? 'darkanita'}/${r.name}`;
---
<Base>
  <h1>{site.name}</h1>
  <p class="tag">{site.tagline}<span class="caret" aria-hidden="true"></span></p>
  <ul class="creds">
    {credentials.map((c) => (
      <li>{c.text}{c.link && <> <a href={c.link.href}>{c.link.label}</a></>}</li>
    ))}
  </ul>

  <section aria-labelledby="charlas-h">
    <h2 id="charlas-h">Charlas recientes</h2>
    <ul class="rows">
      {recentTalks.map((t) => (
        <li>
          <span class="k">{t.year}</span>
          <span><span class="t">{t.event}</span><span class="d">{t.title}</span></span>
        </li>
      ))}
    </ul>
    <p class="more"><a href="/charlas">Todas las charlas</a></p>
  </section>

  <section aria-labelledby="repos-h">
    <h2 id="repos-h">Repos para aprender</h2>
    <ul class="rows">
      {featured.map((r) => (
        <li>
          <span class="k">{r.topic.split(' ')[0]}</span>
          <span>
            <a class="t" href={repoUrl(r)}>{r.name}</a>
            {stars.get(r.name) ? <span class="stars">★ {stars.get(r.name)}</span> : null}
            <span class="d">{r.teaches}</span>
          </span>
        </li>
      ))}
    </ul>
    <p class="more"><a href="/repos">Todos los repos y qué enseña cada uno</a></p>
  </section>

  {posts.length > 0 && (
    <section aria-labelledby="blog-h">
      <h2 id="blog-h">Artículos recientes</h2>
      <ul class="rows">
        {posts.map((p) => (
          <li><span class="k">{new Date(p.date).getFullYear()}</span><a class="t" href={p.url}>{p.title}</a></li>
        ))}
      </ul>
      <p class="more"><a href="/blog">Todos los artículos</a></p>
    </section>
  )}

  {videos.length > 0 && (
    <section aria-labelledby="video-h">
      <h2 id="video-h">Videos recientes</h2>
      <ul class="rows">
        {videos.map((v) => (
          <li><span class="k">{fmtDate(v.date).split(' ').slice(1).join(' ')}</span><a class="t" href={v.url}>{v.title}</a></li>
        ))}
      </ul>
    </section>
  )}
</Base>
